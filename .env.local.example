# ── Fatoura environment ─────────────────────────────────────────────
# Public site URL (used for OpenGraph/metadata). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://fatoura.ma

# Supabase project used only to freeze shared invoice documents (90-day links).
# The server route uses the service key; RLS grants anon INSERT/SELECT only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── Optional: direct email delivery (Gmail API) ────────────────────
# Without these, the UI opens a pre-filled Gmail draft instead.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# ...or a short-lived token (refreshed externally):
GMAIL_ACCESS_TOKEN=
